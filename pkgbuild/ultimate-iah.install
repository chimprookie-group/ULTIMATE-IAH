post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now ultimate-iah-note-plugins.timer >/dev/null 2>&1 || true
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now ultimate-iah-note-plugins.timer >/dev/null 2>&1 || true
  systemctl restart ultimate-iah-note-plugins.timer >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now ultimate-iah-note-plugins.timer >/dev/null 2>&1 || true
}
