# Maintainer: Ultimate IAH
pkgname=ultimate-iah
pkgver=1.25.44
pkgrel=1
pkgdesc='Ultimate IAH — native agentic cockpit, notes and bots'
arch=('x86_64' 'aarch64')
url='https://github.com/chimprookie-group/ULTIMATE-IAH'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-webengine' 'qt6-webchannel' 'qt6-wayland' 'qt6-svg' 'hicolor-icon-theme' 'xdg-desktop-portal' 'xdg-utils' 'polkit' 'nodejs' 'npm' 'python' 'python-yaml' 'git' 'github-cli' 'bubblewrap')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-svg')
provides=('ultimate-iah' 'ultimate-hai' 'deepcrasy-h')
conflicts=('ultimate-hai' 'deepcrasy-h')
replaces=('ultimate-hai' 'deepcrasy-h')
install=ultimate-iah.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ultimate-iah "$pkgdir/usr/bin/ultimate-iah"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/terminal/LICENSE-xterm "$pkgdir/usr/share/licenses/$pkgname/LICENSE-xterm"
  install -Dm644 src/agent/BEHAVIOR.md "$pkgdir/usr/share/ultimate-iah/BEHAVIOR.md"
  install -Dm644 pkgbuild/ultimate-iah.desktop "$pkgdir/usr/share/applications/ultimate-iah.desktop"
  install -Dm644 pkgbuild/ultimate-iah-note-plugins.service "$pkgdir/usr/lib/systemd/system/ultimate-iah-note-plugins.service"
  install -Dm644 pkgbuild/ultimate-iah-note-plugins.timer "$pkgdir/usr/lib/systemd/system/ultimate-iah-note-plugins.timer"
  install -Dm644 assets/icon-128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/ultimate-iah.png"
  install -Dm644 assets/icon-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ultimate-iah.png"
  install -Dm644 assets/icon-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ultimate-iah.png"
  install -Dm644 assets/icon-1024.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/ultimate-iah.png"
}
