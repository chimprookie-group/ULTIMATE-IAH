#!/bin/sh
set -eu

# Installs into ~/.local for machines without passwordless sudo. The package
# path is the real thing; this is the same layout, user-scoped.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"

PREFIX="${HOME}/.local"
install -Dm755 "$ROOT/build/ultimate-iah" "$PREFIX/bin/ultimate-iah"
install -Dm644 "$ROOT/pkgbuild/ultimate-iah.desktop" "$PREFIX/share/applications/ultimate-iah.desktop"
install -Dm644 "$ROOT/assets/icon-128.png" "$PREFIX/share/icons/hicolor/128x128/apps/ultimate-iah.png"
install -Dm644 "$ROOT/assets/icon-256.png" "$PREFIX/share/icons/hicolor/256x256/apps/ultimate-iah.png"
install -Dm644 "$ROOT/assets/icon-512.png" "$PREFIX/share/icons/hicolor/512x512/apps/ultimate-iah.png"
install -Dm644 "$ROOT/assets/icon-1024.png" "$PREFIX/share/icons/hicolor/1024x1024/apps/ultimate-iah.png"

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$PREFIX/share/applications" || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$PREFIX/share/icons/hicolor" || true

echo "Installed into $PREFIX. Launch Ultimate IAH from the app launcher."
