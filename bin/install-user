#!/bin/sh
set -eu

# Installs into ~/.local for machines without passwordless sudo. The package
# path (bin/install) is the real thing; this is the same layout, user-scoped.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"

PREFIX="${HOME}/.local"
install -Dm755 "$ROOT/build/ultimate-hai" "$PREFIX/bin/ultimate-hai"
install -Dm644 "$ROOT/pkgbuild/ultimate-hai.desktop" "$PREFIX/share/applications/ultimate-hai.desktop"
install -Dm644 "$ROOT/pkgbuild/ultimate-hai.svg" "$PREFIX/share/icons/hicolor/scalable/apps/ultimate-hai.svg"
install -Dm644 "$ROOT/assets/icon-256.png" "$PREFIX/share/icons/hicolor/256x256/apps/ultimate-hai.png"
install -Dm644 "$ROOT/assets/icon-512.png" "$PREFIX/share/icons/hicolor/512x512/apps/ultimate-hai.png"

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$PREFIX/share/applications" || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$PREFIX/share/icons/hicolor" || true

echo "Installed into $PREFIX. Launch Ultimate IAH from the app launcher."
